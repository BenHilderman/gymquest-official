{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 14,
  "permissions": {
    "allow": [
      "Bash(xcodebuild:*)",
      "Bash(xcrun simctl:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git worktree:*)",
      "Bash(git add:*)",
      "Bash(git restore:*)",
      "Bash(git rev-parse:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(swift build:*)",
      "Bash(swift test:*)"
    ]
  }
}
